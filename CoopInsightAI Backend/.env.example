# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (required) ─────────────────────────────────────────────────────
# Create the database first:  createdb coopinsight_ai
# The AI service must be pointed at this same database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/coopinsight_ai

# ─── Auth (required) ─────────────────────────────────────────────────────────
# Generate your own. Any long random string works:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# ─── Frontend ────────────────────────────────────────────────────────────────
# Used for CORS in production. In development any localhost port is allowed.
CLIENT_URL=http://localhost:5173

# ─── AI service ──────────────────────────────────────────────────────────────
# Where the Python FastAPI service listens. If it is not running the backend
# degrades gracefully and the AI pages show "reachable: false".
AI_SERVICE_URL=http://localhost:8000

# ─── Optional integrations ───────────────────────────────────────────────────
# Everything below is optional. Leave blank and the app still runs: email and
# SMS calls are logged rather than sent, and uploads go to local disk.

# Email (Resend). Without a key, verification codes are printed to the server
# console and returned as `devOtp` in the login response when NODE_ENV is not
# "production" — which is how you log in during development.
RESEND_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=CoopInsight AI

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# Document storage. Not in use — uploads are written to ./uploads on local disk
# and served from /uploads. These keys are placeholders only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=
