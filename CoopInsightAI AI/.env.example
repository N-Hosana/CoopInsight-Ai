# Same database the Node backend uses — the AI service reads it directly,
# because the backend only ever passes a cooperativeId.
DATABASE_URL=postgresql://postgres:password@localhost:5432/coopinsight_ai

# Where this service listens. The Node backend's AI_SERVICE_URL must match.
HOST=0.0.0.0
PORT=8000

# Where fitted model parameters and metrics are written.
MODEL_STORE=./model_store

LOG_LEVEL=INFO
